# Homelab Scripts Configuration
# Copy to .env and source before running scripts, or export vars individually

# === Audiobookshelf ===
ABS_URL=http://localhost:13378
ABS_API_TOKEN=your_audiobookshelf_api_token

# === Calibre ===
# calibre-autoadd-watcher.sh
WATCH_DIR=/path/to/ebook/downloads
AUTOADD_DIR=/path/to/calibre/autoadd

# pdf-to-epub-watcher.sh
QUARANTINE_DIR=/path/to/pdf-quarantine
INCOMING_DIR=/path/to/ebook/incoming
CALIBRE_CONTAINER=calibre

# === Infrastructure ===
# start-media-server.sh
COMPOSE_DIR=/path/to/docker-compose-directory

# tautulli-newsletter-discord.py
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
INTERNAL_URL=http://localhost:8181
PUBLIC_URL=https://stats.yourdomain.com

# === General ===
LOG_DIR=/var/log/homelab-scripts
