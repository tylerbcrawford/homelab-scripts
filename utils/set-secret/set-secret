#!/usr/bin/env bash
# set-secret — paste an API key/token into its home without it ever touching
# the screen, shell history, ps, or an LLM. Registry: registry-<hostname>.conf
# Usage: set-secret            (pick from list)
#        set-secret <bundle>   (several related values in one run, e.g. client id + secret)
#        set-secret <name>     (go straight to it)
#        set-secret --list     (names + targets, never values)
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REG="${SET_SECRET_REGISTRY:-$DIR/registry-$(hostname -s).conf}"
[[ -f $REG ]] || { echo "No registry for this host: $REG" >&2; exit 1; }

# registry line: name | target-file | KEY (or - for whole file) | restart cmd | verify cmd (prints HTTP code; secret in $SECRET)
mapfile -t ROWS < <(grep -vE '^\s*(#|$)' "$REG")
field() { awk -F'|' -v n="$2" '{gsub(/^[ \t]+|[ \t]+$/,"",$n); print $n}' <<<"$1"; }

if [[ ${1:-} == --list ]]; then
  for r in "${ROWS[@]}"; do printf '%-24s %s %s\n' "$(field "$r" 1)" "$(field "$r" 2)" "$(field "$r" 3)"; done; exit 0
fi

name="${1:-}"
if [[ -z $name ]]; then
  i=1; for r in "${ROWS[@]}"; do printf '%2d) %s\n' $i "$(field "$r" 1)"; ((i++)); done
  read -rp "Number: " n; name="$(field "${ROWS[$((n-1))]}" 1)"
fi
find_row() { local r; for r in "${ROWS[@]}"; do [[ $(field "$r" 1) == "$1" ]] && { printf '%s' "$r"; return 0; }; done; return 1; }
row="$(find_row "$name")" || { echo "Unknown secret '$name'. Try: set-secret --list" >&2; exit 1; }

# Bundle row: name | bundle: member1 member2 ...  → prompt for each member in order (one run),
# then run each distinct restart once at the end. Later members' verify can read earlier
# members from their file, because each member is saved before the next prompt.
members=("$name")
if [[ $(field "$row" 2) == bundle:* ]]; then
  read -ra members <<<"$(field "$row" 2 | sed 's/^bundle://')"
  echo "Bundle $name: ${#members[@]} values (${members[*]})"
fi

RESTARTS=()
set_one() {
  local row file key restart verify code a tmp
  row="$(find_row "$1")" || { echo "Bundle member '$1' not in registry" >&2; exit 1; }
  file="$(field "$row" 2)"; file="${file/#\~/$HOME}"; key="$(field "$row" 3)"
  restart="$(field "$row" 4)"; verify="$(field "$row" 5)"

  echo; echo "Setting: $1  →  $file${key:+ ($key)}"
  read -rsp "Paste value (hidden), then Enter: " SECRET; echo
  [[ -n $SECRET ]] || { echo "Empty — nothing changed."; exit 1; }
  SECRET="${SECRET//$'\r'/}"; SECRET="$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//' <<<"$SECRET")"
  export SECRET

  if [[ -n $verify ]]; then
    code="$(bash -c "$verify" 2>/dev/null || true)"
    if [[ $code =~ ^2 ]]; then echo "✓ provider accepted it (HTTP $code)"
    else read -rp "✗ verify returned '${code:-error}'. Save anyway? [y/N] " a; [[ $a == [yY] ]] || exit 1; fi
  fi

  mkdir -p "$(dirname "$file")"; touch "$file"
  [[ -f $file ]] && cp -p "$file" "$file.bak.$(date +%Y%m%d%H%M%S)" && chmod 600 "$file".bak.*
  tmp="$(mktemp "$file.XXXX")"
  if [[ $key == - || -z $key ]]; then
    printf '%s\n' "$SECRET" > "$tmp"
  else
    KEY="$key" awk 'BEGIN{k=ENVIRON["KEY"]; v=ENVIRON["SECRET"]; d=0}
      index($0, k"=")==1 {print k"="v; d=1; next} {print}
      END{if(!d) print k"="v}' "$file" > "$tmp"
  fi
  chmod 600 "$tmp"; mv "$tmp" "$file"
  echo "✓ saved (chmod 600; previous copy kept as .bak)"
  unset SECRET
  [[ -n $restart && ! " ${RESTARTS[*]} " =~ " $restart " ]] && RESTARTS+=("$restart")
  return 0
}

for m in "${members[@]}"; do set_one "$m"; done
for r in "${RESTARTS[@]}"; do echo "Restarting: $r"; bash -c "$r" && echo "✓ restarted"; done
exit 0
