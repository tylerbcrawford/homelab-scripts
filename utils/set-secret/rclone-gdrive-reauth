#!/usr/bin/env bash
# Sign gdrive: in under our own OAuth client (~/.config/rclone/gdrive-oauth.env).
# Works on a private copy of rclone.conf and replaces the live one only after a
# forced token refresh succeeds, so an abandoned sign-in changes nothing.
# New client: set-secret rclone-gdrive (stores only), then this.
# Run over: ssh -t -L 53682:localhost:53682 dev '~/.local/bin/rclone-gdrive-reauth'
set -euo pipefail
umask 077
APPLY="$(dirname "$(readlink -f "$0")")/rclone-gdrive-apply"
LIVE="$(rclone config file | tail -1)"
WORK="$(mktemp -d "$(dirname "$LIVE")/.reauth.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
export RCLONE_CONFIG="$WORK/rclone.conf"
cp "$LIVE" "$RCLONE_CONFIG"
"$APPLY"
for k in client_id client_secret; do
  grep -q "^$k = ." "$RCLONE_CONFIG" || { echo "no $k stored: run set-secret rclone-gdrive"; exit 1; }
done
# mode: drop = remove the old client's token; expire = force a refresh on next use
token() { MODE=$1 python3 - <<'PY'
import configparser, json, os
p = os.environ["RCLONE_CONFIG"]
c = configparser.RawConfigParser(); c.optionxform = str; c.read(p)
g = c["gdrive"]
if os.environ["MODE"] == "drop":
    g.pop("token", None)
else:
    t = json.loads(g["token"])
    assert t.get("refresh_token"), "Google returned no refresh token"
    t["expiry"] = "2020-01-01T00:00:00Z"; g["token"] = json.dumps(t)
with open(p, "w") as f: c.write(f)
PY
}
token drop
echo "Open the link below in your browser and sign in (Advanced > Go to rclone)."
# stdout would print the new token; the sign-in link goes to stderr
rclone config update gdrive config_is_local=true config_change_team_drive=false >/dev/null
token expire
rclone lsd gdrive: >/dev/null
echo "forced refresh: OK"
cp -p "$LIVE" "$LIVE.bak"
mv "$RCLONE_CONFIG" "$LIVE"
unset RCLONE_CONFIG
rclone lsd gdrive: >/dev/null
echo "done: gdrive: is live on your own client"
