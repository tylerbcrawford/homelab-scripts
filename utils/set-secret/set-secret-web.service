# systemd --user unit. Install: ln -sf <repo>/utils/set-secret/set-secret-web.service ~/.config/systemd/user/
# then: systemctl --user daemon-reload && systemctl --user enable --now set-secret-web
[Unit]
Description=set-secret web front-end (Tailscale-only)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/set-secret-web
Environment=SET_SECRET_WEB_PEERS=srv1469666=http://100.94.198.72:3900,tyler-MINI-S=http://100.83.95.43:3900
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
