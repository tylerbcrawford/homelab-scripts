#!/usr/bin/env python3
"""set-secret-web — browser front-end for set-secret, Tailscale-only.

Binds to this host's Tailscale IP only. Each request's source IP is checked
with `tailscale whois`; only the tailnet owner's login (or SET_SECRET_WEB_USERS,
comma-separated) gets through. Values are POSTed, piped to
`set-secret --stdin <name>` on stdin (never argv, never logged), and only
set-secret's status lines come back. Stdlib only.

Env: SET_SECRET_WEB_PORT (3900), SET_SECRET_WEB_PEERS ("800802=http://100.94.198.72:3900,...")
"""
import html, json, os, re, socket, subprocess, sys, threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs

DIR = os.path.dirname(os.path.realpath(__file__))
SCRIPT = os.path.join(DIR, "set-secret")
HOST = socket.gethostname().split(".")[0]
REG = os.environ.get("SET_SECRET_REGISTRY", os.path.join(DIR, f"registry-{HOST}.conf"))
PORT = int(os.environ.get("SET_SECRET_WEB_PORT", "3900"))
LABELS = dict(p.split("=", 1) for p in os.environ.get("SET_SECRET_WEB_LABELS", "").split(",") if "=" in p)
PEERS = [p.split("=", 1) for p in os.environ.get("SET_SECRET_WEB_PEERS", "").split(",") if "=" in p]


def ts_json(*args):
    return json.loads(subprocess.run(["tailscale", args[0], "--json", *args[1:]], capture_output=True, text=True, timeout=10).stdout)


def self_info():
    st = ts_json("status")
    ip = next(a for a in st["Self"]["TailscaleIPs"] if ":" not in a)
    owner = st["User"][str(st["Self"]["UserID"])]["LoginName"]
    return ip, owner


BIND_IP, OWNER = self_info()
ALLOWED = {u.strip() for u in os.environ.get("SET_SECRET_WEB_USERS", OWNER).split(",") if u.strip()}
_whois_cache = {}


def caller_login(ip):
    if ip not in _whois_cache:
        try:
            _whois_cache[ip] = ts_json("whois", ip).get("UserProfile", {}).get("LoginName", "")
        except Exception:
            return ""
    return _whois_cache[ip]


def load_registry():
    rows = {}
    with open(REG) as f:
        for line in f:
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            parts = [p.strip() for p in line.rstrip("\n").split("|")] + [""] * 5
            name, target, key, restart, verify = parts[:5]
            rows[name] = dict(name=name, target=target, key=key, restart=restart, verify=bool(verify))
    for r in rows.values():
        r["members"] = r["target"][len("bundle:"):].split() if r["target"].startswith("bundle:") else [r["name"]]
    return rows


