def page(title, body):
    nav = "".join(f'<a href="{html.escape(u)}/" class="{"on" if h == HOST else ""}">{html.escape(LABELS.get(h, h))}</a>' for h, u in PEERS)
    nav = f"<nav>{nav}</nav>" if len(PEERS) > 1 else ""
    return f"""<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer"><title>{html.escape(title)} · {html.escape(LABELS.get(HOST, HOST))}</title><style>{CSS}</style></head>
<body><main><header><a class="mark" href="/">set-secret</a>{nav}</header>{body}</main></body></html>"""


def index_page(rows):
    items = []
    for r in rows.values():
        is_b = r["target"].startswith("bundle:")
        tgt = " + ".join(r["members"]) if is_b else f'{r["target"]}{" (" + r["key"] + ")" if r["key"] not in ("", "-") else ""}'
        tags = ('<span class="tag">bundle</span>' if is_b else "") + ('<span class="tag">verify</span>' if r["verify"] else "")
        items.append(f'<li data-n="{html.escape(r["name"])}"><a href="set/{html.escape(r["name"])}"><span>{html.escape(r["name"])}{tags}</span>'
                     f'<span class="t">{html.escape(tgt)}</span></a></li>')
    return page("set-secret", f"""<div class="bar"><input type="search" id="q" placeholder="Filter" aria-label="Filter" autofocus><a class="ghost" href="new">New</a></div><ul id="l">{''.join(items)}</ul>
<script>q.oninput=()=>{{for(const li of l.children)li.hidden=!li.dataset.n.includes(q.value.toLowerCase())}}</script>""")


def form_page(rows, name, note=""):
    r = rows[name]
    fields = ""
    for m in r["members"]:
        mr = rows.get(m, {})
        dest = f'{mr.get("target", "?")}{" (" + mr.get("key", "") + ")" if mr.get("key") not in ("", "-", None) else ""}'
        fields += (f'<label for="{html.escape(m)}">{html.escape(m)}</label><div class="t">→ {html.escape(dest)}</div>'
                   f'<input type="password" name="v" id="{html.escape(m)}" required autocomplete="off" spellcheck="false">')
    force = '<label><input type="checkbox" name="force" value="1"> Save even if the provider check fails</label>' if note else ""
    restart = f'<p class="t">Afterwards runs: {html.escape(r["restart"])}</p>' if r["restart"] else ""
    return page(name, f"""{note}<form class="card" method="post" autocomplete="off">
{fields}{force}{restart}<button>Save</button></form>""")


NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,40}$")
KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,63}$")
FILE_RE = re.compile(r"^~/[A-Za-z0-9._/-]+$")


def new_page(note="", f=None):
    f = f or {}
    v = lambda k: html.escape(f.get(k, [""])[0])
    return page("new secret", f"""{note}
<form class="card" method="post" autocomplete="off">
<label for="name">Name</label><input type="search" name="name" id="name" value="{v('name')}" required placeholder="e.g. rmx-mailgun" pattern="[a-z0-9][a-z0-9-]{{1,40}}">
<label for="file">File</label><input type="search" name="file" id="file" value="{v('file')}" required placeholder="~/projects/app/.env" pattern="~/[A-Za-z0-9._/-]+">
<label for="key">KEY in that file</label><input type="search" name="key" id="key" value="{v('key')}" placeholder="MAILGUN_API_KEY — leave blank if the whole file is the secret">
<label for="key2">Second KEY (optional, for an ID + secret pair)</label><input type="search" name="key2" id="key2" value="{v('key2')}" placeholder="e.g. MAILGUN_DOMAIN — makes a bundle, both entered in one form">
<p class="t">Restart and verify commands can only be added from the CLI (they run as shell). Edit the registry row afterwards if you need them.</p>
<button>Create, then enter the value</button></form>""")


def git_sync(msg):
    def run():
        try:
            subprocess.run(["git", "-C", DIR, "add", REG], timeout=30, capture_output=True)
            subprocess.run(["git", "-C", DIR, "commit", "-m", msg, "--", REG], timeout=30, capture_output=True)
            r = subprocess.run(["git", "-C", DIR, "pull", "--rebase", "--autostash", "-q"], timeout=60, capture_output=True)
            if r.returncode == 0:
                subprocess.run(["git", "-C", DIR, "push", "-q"], timeout=60, capture_output=True)
            sys.stderr.write(f"git sync: {msg} (pull rc={r.returncode})\n")
        except Exception as e:
            sys.stderr.write(f"git sync failed: {e}\n")
    threading.Thread(target=run, daemon=True).start()


def create_rows(rows, form):
    g = lambda k: form.get(k, [""])[0].strip()
    name, file, key, key2 = g("name"), g("file"), g("key"), g("key2")
    if not NAME_RE.match(name): return "Name: lowercase letters, digits and dashes."
    if not FILE_RE.match(file) or "/../" in file + "/" or file.endswith("/"): return "File must be a path under ~/ (letters, digits, . _ - /)."
    real = os.path.realpath(os.path.expanduser(file))
    if not real.startswith(os.path.expanduser("~") + "/"): return "File must resolve inside your home directory."
    if key and not KEY_RE.match(key): return "KEY: letters, digits, underscore."
    if key2 and (not key or not KEY_RE.match(key2) or key2 == key): return "Second KEY needs a first KEY and must differ from it."
    new = []
    if key2:
        m1, m2 = f"{name}-{key.lower().replace('_', '-')}", f"{name}-{key2.lower().replace('_', '-')}"
        new = [(m1, f"{m1} | {file} | {key} | |"), (m2, f"{m2} | {file} | {key2} | |"), (name, f"{name} | bundle: {m1} {m2}")]
    else:
        new = [(name, f"{name} | {file} | {key or '-'} | |")]
    clash = [n for n, _ in new if n in rows]
    if clash: return f"Already in the registry: {', '.join(clash)}"
    with open(REG, "a") as fh:
        fh.write("".join(line + "\n" for _, line in new))
    git_sync(f"set-secret: add {name} ({HOST}, via web)")
    return None


class H(BaseHTTPRequestHandler):
    server_version = "set-secret-web"
    sys_version = ""

    def log_message(self, fmt, *a):  # request line only; bodies are never logged
        sys.stderr.write(f"{self.peer_ip() or self.client_address[0]} {fmt % a}\n")

    def send(self, code, body, ctype="text/html; charset=utf-8"):
        b = body.encode()
        self.send_response(code)
        for k, v in {"Content-Type": ctype, "Content-Length": str(len(b)), "Cache-Control": "no-store",
                     "X-Frame-Options": "DENY", "Referrer-Policy": "no-referrer",
                     "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'"}.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(b)

    def peer_ip(self):
        # Behind host nginx (secret.800801.online) the TCP peer is this host itself;
        # only then is X-Real-IP (set by nginx to $remote_addr) trusted.
        ip = self.client_address[0]
        if ip in ("127.0.0.1", "::1", BIND_IP):
            return (self.headers.get("X-Real-IP") or "").strip()
        return ip

    def gate(self):
        who = caller_login(self.peer_ip()) if self.peer_ip() else ""
        if who not in ALLOWED:
            self.send(403, "forbidden", "text/plain")
            return False
        return True

    def do_GET(self):
        if not self.gate():
            return
        rows = load_registry()
        p = self.path.split("?")[0]
        if p == "/":
            return self.send(200, index_page(rows))
        if p == "/new":
            return self.send(200, new_page())
        if p.startswith("/set/") and p[5:] in rows:
            return self.send(200, form_page(rows, p[5:]))
        self.send(404, "not found", "text/plain")

    def do_POST(self):
        if not self.gate():
            return
        # CSRF: a browser POST must come from this same origin
        origin = self.headers.get("Origin")
        if origin and origin not in (f"http://{self.headers.get('Host')}", f"https://{self.headers.get('Host')}"):
            return self.send(403, "bad origin", "text/plain")
        rows = load_registry()
        if self.path.split("?")[0] == "/new":
            n = int(self.headers.get("Content-Length") or 0)
            if n > 4096:
                return self.send(413, "too large", "text/plain")
            form = parse_qs(self.rfile.read(n).decode())
            err = create_rows(rows, form)
            if err:
                return self.send(400, new_page(f'<p class="warn">{html.escape(err)}</p>', form))
            self.send_response(303)
            self.send_header("Location", "set/" + form["name"][0].strip())
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        name = self.path.split("?")[0][5:] if self.path.startswith("/set/") else ""
        if name not in rows:
            return self.send(404, "not found", "text/plain")
        n = int(self.headers.get("Content-Length") or 0)
        if n > 65536:
            return self.send(413, "too large", "text/plain")
        form = parse_qs(self.rfile.read(n).decode(), keep_blank_values=True)
        vals = form.get("v", [])
        if len(vals) != len(rows[name]["members"]) or any(not v.strip() or "\n" in v for v in vals):
            return self.send(400, form_page(rows, name, '<p class="warn">Every field needs a single-line value.</p>'))
        cmd = [SCRIPT, "--stdin"] + (["--force"] if form.get("force") else []) + [name]
        p = subprocess.run(cmd, input="".join(v + "\n" for v in vals), capture_output=True, text=True, timeout=180,
                           env={**os.environ, "SET_SECRET_REGISTRY": REG})
        del vals, form
        out = html.escape((p.stdout + p.stderr).strip())
        if p.returncode == 3:  # verify failed, nothing saved for that member
            return self.send(200, form_page(rows, name, f'<pre class="bad">{out}</pre><p class="warn">Provider rejected it. Re-enter, or tick the box to save anyway.</p>'))
        cls = "" if p.returncode == 0 else ' class="bad"'
        self.send(200, page(name, f'<pre{cls}>{out}</pre><p><a href="/">Done</a></p>'))


if __name__ == "__main__":
    print(f"set-secret-web on http://{BIND_IP}:{PORT} for {sorted(ALLOWED)} ({REG})", flush=True)
    ThreadingHTTPServer((BIND_IP, PORT), H).serve_forever()
