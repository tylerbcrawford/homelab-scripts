#!/usr/bin/env python3
"""set-secret-web — browser front-end for set-secret, Tailscale-only.

Binds to this host's Tailscale IP only. Each request's source IP is checked
with `tailscale whois`; only the tailnet owner's login (or SET_SECRET_WEB_USERS,
comma-separated) gets through. Values are POSTed, piped to
`set-secret --stdin <name>` on stdin (never argv, never logged), and only
set-secret's status lines come back. Stdlib only.

Env: SET_SECRET_WEB_PORT (3900), SET_SECRET_WEB_PEERS ("800802=http://100.94.198.72:3900,...")
"""
import html, json, os, socket, subprocess, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs

DIR = os.path.dirname(os.path.realpath(__file__))
SCRIPT = os.path.join(DIR, "set-secret")
HOST = socket.gethostname().split(".")[0]
REG = os.environ.get("SET_SECRET_REGISTRY", os.path.join(DIR, f"registry-{HOST}.conf"))
PORT = int(os.environ.get("SET_SECRET_WEB_PORT", "3900"))
PEERS = [p.split("=", 1) for p in os.environ.get("SET_SECRET_WEB_PEERS", "").split(",") if "=" in p]


def ts_json(*args):
    return json.loads(subprocess.run(["tailscale", args[0], "--json", *args[1:]], capture_output=True, text=True, timeout=10).stdout)


def self_info():
    st = ts_json("status")
    ip = next(a for a in st["Self"]["TailscaleIPs"] if ":" not in a)
    owner = st["User"][str(st["Self"]["UserID"])]["LoginName"]
    return ip, owner


BIND_IP, OWNER = self_info()
ALLOWED = {u.strip() for u in os.environ.get("SET_SECRET_WEB_USERS", OWNER).split(",") if u.strip()}
_whois_cache = {}


def caller_login(ip):
    if ip not in _whois_cache:
        try:
            _whois_cache[ip] = ts_json("whois", ip).get("UserProfile", {}).get("LoginName", "")
        except Exception:
            return ""
    return _whois_cache[ip]


def load_registry():
    rows = {}
    with open(REG) as f:
        for line in f:
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            parts = [p.strip() for p in line.rstrip("\n").split("|")] + [""] * 5
            name, target, key, restart, verify = parts[:5]
            rows[name] = dict(name=name, target=target, key=key, restart=restart, verify=bool(verify))
    for r in rows.values():
        r["members"] = r["target"][len("bundle:"):].split() if r["target"].startswith("bundle:") else [r["name"]]
    return rows


CSS = """
:root{--blue:#00A9E0;--green:#00C389;--yellow:#FFD700;--red:#F9423A;--bg:#F5F5F5;--card:#fff;--fg:#000;--mut:#666;--line:#e2e2e2}
@media(prefers-color-scheme:dark){:root{--bg:#000;--card:#111;--fg:#fff;--mut:#999;--line:#2a2a2a}}
*{box-sizing:border-box}body{margin:0;font:15px/1.45 Inter,system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--fg)}
main{max-width:760px;margin:0 auto;padding:24px 16px 64px}h1{font:700 26px 'Space Grotesk',Inter,sans-serif;margin:0 0 4px}
.sub{color:var(--mut);margin:0 0 16px}nav a{margin-right:12px;color:var(--blue);text-decoration:none}nav a.on{font-weight:700;color:var(--fg)}
input[type=search],input[type=password]{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--fg);font:inherit}
ul{list-style:none;padding:0;margin:16px 0}li{background:var(--card);border:1px solid var(--line);border-radius:10px;margin:8px 0}
li a{display:flex;justify-content:space-between;gap:12px;padding:12px 14px;color:inherit;text-decoration:none}li a:hover{border-color:var(--blue)}
.t{color:var(--mut);font:12px ui-monospace,monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tag{font-size:11px;padding:1px 7px;border-radius:99px;border:1px solid var(--blue);color:var(--blue);margin-left:6px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;margin:16px 0}label{display:block;font-weight:600;margin:14px 0 6px}
button{margin-top:16px;padding:10px 18px;border:0;border-radius:8px;background:var(--blue);color:#fff;font:600 15px inherit;cursor:pointer}
pre{white-space:pre-wrap;background:var(--card);border-left:4px solid var(--green);padding:12px;border-radius:6px}pre.bad{border-color:var(--red)}
.warn{color:var(--red);font-weight:600}a{color:var(--blue)}
"""


def page(title, body):
    nav = "".join(f'<a href="{html.escape(u)}/" class="{"on" if h == HOST else ""}">{html.escape(h)}</a>' for h, u in PEERS)
    return f"""<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer"><title>{html.escape(title)}</title><style>{CSS}</style></head>
<body><main><nav>{nav}</nav><h1>set-secret <span style="color:var(--blue)">{html.escape(HOST)}</span></h1>{body}</main></body></html>"""


def index_page(rows):
    items = []
    for r in rows.values():
        is_b = r["target"].startswith("bundle:")
        tgt = " + ".join(r["members"]) if is_b else f'{r["target"]}{" (" + r["key"] + ")" if r["key"] not in ("", "-") else ""}'
        tags = ('<span class="tag">bundle</span>' if is_b else "") + ('<span class="tag">verify</span>' if r["verify"] else "")
        items.append(f'<li data-n="{html.escape(r["name"])}"><a href="set/{html.escape(r["name"])}"><span>{html.escape(r["name"])}{tags}</span>'
                     f'<span class="t">{html.escape(tgt)}</span></a></li>')
    return page("set-secret", f"""<p class="sub">Pick a secret. Values go straight to this host's file; nothing is shown back.</p>
<input type="search" id="q" placeholder="Filter…" autofocus><ul id="l">{''.join(items)}</ul>
<script>q.oninput=()=>{{for(const li of l.children)li.hidden=!li.dataset.n.includes(q.value.toLowerCase())}}</script>""")


def form_page(rows, name, note=""):
    r = rows[name]
    fields = ""
    for m in r["members"]:
        mr = rows.get(m, {})
        dest = f'{mr.get("target", "?")}{" (" + mr.get("key", "") + ")" if mr.get("key") not in ("", "-", None) else ""}'
        fields += (f'<label for="{html.escape(m)}">{html.escape(m)}</label><div class="t">→ {html.escape(dest)}</div>'
                   f'<input type="password" name="v" id="{html.escape(m)}" required autocomplete="off" spellcheck="false">')
    force = '<label><input type="checkbox" name="force" value="1"> Save even if the provider check fails</label>' if note else ""
    restart = f'<p class="t">Afterwards runs: {html.escape(r["restart"])}</p>' if r["restart"] else ""
    return page(name, f"""<p><a href="../">← all secrets</a></p>{note}<form class="card" method="post" autocomplete="off">
{fields}{force}{restart}<button>Save</button></form>""")


class H(BaseHTTPRequestHandler):
    server_version = "set-secret-web"
    sys_version = ""

    def log_message(self, fmt, *a):  # request line only; bodies are never logged
        sys.stderr.write(f"{self.peer_ip() or self.client_address[0]} {fmt % a}\n")

    def send(self, code, body, ctype="text/html; charset=utf-8"):
        b = body.encode()
        self.send_response(code)
        for k, v in {"Content-Type": ctype, "Content-Length": str(len(b)), "Cache-Control": "no-store",
                     "X-Frame-Options": "DENY", "Referrer-Policy": "no-referrer",
                     "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'"}.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(b)

    def peer_ip(self):
        # Behind host nginx (secret.800801.online) the TCP peer is this host itself;
        # only then is X-Real-IP (set by nginx to $remote_addr) trusted.
        ip = self.client_address[0]
        if ip in ("127.0.0.1", "::1", BIND_IP):
            return (self.headers.get("X-Real-IP") or "").strip()
        return ip

    def gate(self):
        who = caller_login(self.peer_ip()) if self.peer_ip() else ""
        if who not in ALLOWED:
            self.send(403, "forbidden", "text/plain")
            return False
        return True

    def do_GET(self):
        if not self.gate():
            return
        rows = load_registry()
        p = self.path.split("?")[0]
        if p == "/":
            return self.send(200, index_page(rows))
        if p.startswith("/set/") and p[5:] in rows:
            return self.send(200, form_page(rows, p[5:]))
        self.send(404, "not found", "text/plain")

    def do_POST(self):
        if not self.gate():
            return
        # CSRF: a browser POST must come from this same origin
        origin = self.headers.get("Origin")
        if origin and origin not in (f"http://{self.headers.get('Host')}", f"https://{self.headers.get('Host')}"):
            return self.send(403, "bad origin", "text/plain")
        rows = load_registry()
        name = self.path.split("?")[0][5:] if self.path.startswith("/set/") else ""
        if name not in rows:
            return self.send(404, "not found", "text/plain")
        n = int(self.headers.get("Content-Length") or 0)
        if n > 65536:
            return self.send(413, "too large", "text/plain")
        form = parse_qs(self.rfile.read(n).decode(), keep_blank_values=True)
        vals = form.get("v", [])
        if len(vals) != len(rows[name]["members"]) or any(not v.strip() or "\n" in v for v in vals):
            return self.send(400, form_page(rows, name, '<p class="warn">Every field needs a single-line value.</p>'))
        cmd = [SCRIPT, "--stdin"] + (["--force"] if form.get("force") else []) + [name]
        p = subprocess.run(cmd, input="".join(v + "\n" for v in vals), capture_output=True, text=True, timeout=180,
                           env={**os.environ, "SET_SECRET_REGISTRY": REG})
        del vals, form
        out = html.escape((p.stdout + p.stderr).strip())
        if p.returncode == 3:  # verify failed, nothing saved for that member
            return self.send(200, form_page(rows, name, f'<pre class="bad">{out}</pre><p class="warn">Provider rejected it. Re-enter, or tick the box to save anyway.</p>'))
        cls = "" if p.returncode == 0 else ' class="bad"'
        self.send(200, page(name, f'<pre{cls}>{out}</pre><p><a href="../">← all secrets</a></p>'))


if __name__ == "__main__":
    print(f"set-secret-web on http://{BIND_IP}:{PORT} for {sorted(ALLOWED)} ({REG})", flush=True)
    ThreadingHTTPServer((BIND_IP, PORT), H).serve_forever()
